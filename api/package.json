  "scripts": {
    "build": "nest build",
    "start": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node .",
    "lint": "oxlint",
    "format": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "npm test -- --project e2e",
    "test:integration": "npm test -- --project integration",
    "test:unit": "npm test -- --project unit --coverage",
