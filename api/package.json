    "@swc/core": "^1",
    "@tsconfig/node24": "^24",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/supertest": "^7",
    "@vitest/coverage-v8": "^5",
    "dotenv": "^17",
    "dotenv-cli": "^11",
    "oxfmt": "^0",
