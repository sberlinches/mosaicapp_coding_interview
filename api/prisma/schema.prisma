generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["api"]
}

model Employee {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  personName    String   @map("person_name") @db.VarChar(50)
  role          String   @map("role") @db.VarChar(50)
  team          String   @map("team") @db.VarChar(50)
  allocationPct Int      @map("allocation_pct") @db.SmallInt
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date

  @@map("employees")
  @@schema("api")
}

model PlanVersion {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String           @db.VarChar(100)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rows      PlanVersionRow[]

  @@index([createdAt])
  @@map("plan_versions")
  @@schema("api")
}

model PlanVersionRow {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId     String      @map("version_id") @db.Uuid
  rowKey        String      @map("row_key") @db.Uuid
  personName    String      @map("person_name") @db.VarChar(50)
  role          String      @db.VarChar(50)
  team          String      @db.VarChar(50)
  allocationPct Int         @map("allocation_pct") @db.SmallInt
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  version       PlanVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([versionId, rowKey])
  @@index([versionId])
  @@map("plan_version_rows")
  @@schema("api")
}
